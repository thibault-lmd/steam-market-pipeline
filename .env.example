# Copy this file to .env and replace the values.
# .env is never committed (see .gitignore).

# --- PostgreSQL ---

# Read by docker compose when the pgdata volume is CREATED.
# Changing it after the first start has no effect: destroy the
# volume (docker compose down -v) to reset it.
POSTGRES_PASSWORD=changeme

# Must repeat the same password as above.
# steam / steam_market come from POSTGRES_USER and POSTGRES_DB
# in docker-compose.yml.
DATABASE_URL=postgresql://steam:changeme@localhost:5432/steam_market

# --- Steam collection ---
# Optional. config.py provides defaults for all three.

# Country code: determines both prices and currency.
STEAM_CC=fr

# Seconds to wait between two API calls.
REQUEST_DELAY=1.5

# Number of games processed between two commits.
BATCH_SIZE=50